{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [ "james090500", "Siriuo" ],
  "contact": {
    "homepage": "https://minecraftcapes.net/",
    "sources": "https://github.com/minecraftcapes/minecraftcapes-mod",
    "issues": "https://github.com/MinecraftCapes/minecraftcapes-mod/issues"
  },
  "license": "${license}",
  "icon": "logo.png",
  "entrypoints": {
    "client": [
      "net.minecraftcapes.fabric.FabricClient"
    ],
    "server" : [
      "net.minecraftcapes.fabric.FabricServer"
    ]
  },
  "mixins": [
    {
      "config": "minecraftcapes.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabric-key-mapping-api-v1": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/minecraftcapes"
      }
    }
  }
}